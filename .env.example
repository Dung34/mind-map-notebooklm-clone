# === Perplexity ===
PERPLEXITY_API_KEY=
PERPLEXITY_MAX_SEARCH_RESULTS=20
PERPLEXITY_VERIFY_HTTP=true

# === FireCrawl ===
FIRECRAWL_API_KEY=
FIRECRAWL_MAP_LIMIT=50
FIRECRAWL_MAP_INCLUDE_SUBDOMAINS=false
FIRECRAWL_SCRAPE_CONCURRENCY=5
FIRECRAWL_SCRAPE_WAIT_MS=1500
FIRECRAWL_SCRAPE_ONLY_MAIN=true
FIRECRAWL_SKIP_SCRAPE_FOR_KNOWN_URLS=true

# === Pipeline ===
OUTPUT_DIR=./out
LOG_LEVEL=INFO
HTTP_TIMEOUT=60
CLEAN_PAGE_MIN_WORDS=50
CHUNK_MAX_WORDS=220
CHUNK_MIN_WORDS=50
CHUNK_OVERLAP_SENTENCES=2

# === Phase 9 (Productionization) ===
# PostgreSQL 16 + pgvector
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/cleaner_raw_data
VECTOR_TABLE=rag_chunks

# Redis 7.x (queue + cache)
REDIS_URL=redis://localhost:6379/0

# OpenAI embeddings (cost-first baseline)
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_BATCH_SIZE=32
EMBEDDING_MAX_RETRIES=4

# Runtime defaults
WORKER_CONCURRENCY=2
INACTIVE_TTL_DAYS=7
MAX_SCRAPE_URLS_PER_RUN=50
MAX_EMBEDDING_TOKENS_PER_RUN=500000
SCRAPE_EST_COST_PER_URL_USD=0.01
EMBED_EST_COST_PER_1K_TOKENS_USD=0.00002

# === Phase 10 (MindMap) ===
MINDMAP_LLM_MODEL=gpt-4o-mini
MINDMAP_LLM_TEMPERATURE=0.2
MINDMAP_TOPIC_REPR_K=5
MINDMAP_TOPIC_TEXT_LIMIT=600
MINDMAP_MAX_DEPTH=3
MINDMAP_MIN_RECURSE_SIZE=12
MINDMAP_SUB_MIN_CLUSTER_SIZE=3
MINDMAP_SUB_MIN_SAMPLES=2
MINDMAP_SUB_N_NEIGHBORS=8
MINDMAP_NER_PROVIDER=spacy
MINDMAP_NER_MODEL=xx_ent_wiki_sm
MINDMAP_MAX_VECTORS_PER_RUN=10000
MINDMAP_MAX_LLM_CALLS_PER_RUN=200
MINDMAP_MAX_TOKENS_PER_RUN=200000
MINDMAP_UMAP_N_NEIGHBORS=15
MINDMAP_UMAP_N_COMPONENTS=8
MINDMAP_UMAP_MIN_DIST=0.0
MINDMAP_UMAP_RANDOM_STATE=42
MINDMAP_HDBSCAN_MIN_CLUSTER_SIZE=5
MINDMAP_HDBSCAN_MIN_SAMPLES=2
MINDMAP_SMALL_N_THRESHOLD=20
